{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "dev": "deno run --env --unstable-otel --allow-net --allow-env --allow-read --unstable-cron --watch main.ts",
    "discord": "deno run --env slashCommand.ts",
    "check": "deno fmt --check && deno lint && deno check **/*.ts",
    "format": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.2",
    "discord-interactions": "npm:discord-interactions@^4.4.0"
  },
  "lint": {
    "include": [
      "**/*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 120,
    "include": [
      "**/*.ts"
    ]
  },
  "deploy": {
    "entrypoint": "main.ts",
    "root": "."
  }
}
